# --- Visual Studio / SSMS ----------------------------------------------------
.vs/
*.suo
*.user
*.sln.docstates
*.dbmdl
*.jfm

# --- Local SQL Server artifacts (never commit database files or backups) -----
*.bak
*.mdf
*.ldf
*.ndf
*.trn

# --- Logs and temporary files ------------------------------------------------
*.log
*.tmp
*.temp
~$*
*~

# --- Operating system files --------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editors / IDEs ----------------------------------------------------------
.vscode/
.idea/

# --- Power BI ----------------------------------------------------------------
# Local cache and user settings generated by Power BI Desktop
.pbi/
localSettings.json
cache.abf
*.pbix.tmp

